<script>
                document.addEventListener("DOMContentLoaded", function() {
                    // Run bv-ads script first
                    (function initAds() {
    
    const container = document.querySelector('.bv-content-wrapper');

    // The container must exist, and the content wrapper must have the class indicating ads should be shown.
    if (!container) { return; }
    if (!container.classList.contains('bv-content-wrapper--with-ads')) { return; }

    const breakpoints = {
        adStep1: window.matchMedia('(min-width: 1216px)'), // Right ad slot appears
        adStep3: window.matchMedia('(min-width: 1696px) and (max-width: 1919px)'), // Left ad slot appears (thin versions only)
        adStep4: window.matchMedia('(min-width: 1920px)') // Left ad expanded in width
    };

    const elementIds = {
        adStep1: 'sidebar-ad-right',
        adStep3: 'sidebar-ad-left-tablet',
        adStep4: 'sidebar-ad-left-desktop'
    }

    const elements = {
        adStep1: `<div id="${elementIds.adStep1}" class="bv-content-wrapper__ad-placement bv-content-wrapper__ad-placement--right"></div>`,
        adStep3: `<div id="${elementIds.adStep3}" class="bv-content-wrapper__ad-placement bv-content-wrapper__ad-placement--left-small"></div>`,
        adStep4: `<div id="${elementIds.adStep4}" class="bv-content-wrapper__ad-placement bv-content-wrapper__ad-placement--left"></div>`
    }

    Object.entries(breakpoints).forEach(([key, mql]) => {
        const handler = (e) => {
            if (e.matches) {
                if (key in elements) {
                    if (key in elementIds && !document.getElementById(elementIds[key])) {
                        container.insertAdjacentHTML('afterbegin', elements[key]); // Prepend to container
                    }
                }
            } else {
                if (key in elementIds) {
                    document.getElementById(elementIds[key])?.remove();
                }
            }
        };
        mql.addEventListener('change', handler);
        handler(mql); // Initial check on load
    });

})();

                    
                    // Then trigger AdThrive loading
                    (function(w, d) {
                        w.adthrive = w.adthrive || {};
                        w.adthrive.cmd = w.adthrive.cmd || [];
                        w.adthrive.plugin = "adthrive-ads-manual";
                        w.adthrive.host = "ads.adthrive.com";var s = d.createElement("script");
                        s.async = true;
                        s.referrerpolicy="no-referrer-when-downgrade";
                        s.src = "https://" + w.adthrive.host + "/sites/630428a76245162875c78210/ads.min.js?referrer=" + w.encodeURIComponent(w.location.href) + "&cb=" + (Math.floor(Math.random() * 100) + 1);
                        var n = d.getElementsByTagName("script")[0];
                        n.parentNode.insertBefore(s, n);
                    })(window, document);
                });
            </script>
